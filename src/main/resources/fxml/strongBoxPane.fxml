<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
            minWidth="-Infinity" xmlns="http://javafx.com/javafx/16"
            fx:controller="it.polimi.ingsw.clients.viewer.controllers.StrongBoxController">
    <top>
        <TitledPane alignment="CENTER" animated="false" collapsible="false" contentDisplay="CENTER" text="STRONGBOX"
                    textAlignment="CENTER" BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <HBox prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../graphics/res/coin.png"/>
                    </ImageView>
                    <Label fx:id="coinLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                           text="Label"/>
                </VBox>
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../graphics/res/servant.png"/>
                    </ImageView>
                    <Label fx:id="servantLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                           text="Label"/>
                </VBox>
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../graphics/res/shield.png"/>
                    </ImageView>
                    <Label fx:id="shieldLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                           text="Label"/>
                </VBox>
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
                <VBox prefHeight="200.0" prefWidth="100.0">
                    <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../graphics/res/stone.png"/>
                    </ImageView>
                    <Label fx:id="stoneLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308"
                           text="Label"/>
                </VBox>
            </AnchorPane>
        </HBox>
    </center>
</BorderPane>
