<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="mainPane" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="it.polimi.ingsw.clients.viewer.controllers.InitialLeader">
    <VBox prefHeight="200.0" prefWidth="100.0">
        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="184.0" prefWidth="830.0" text="Label" />
        <HBox prefHeight="100.0" prefWidth="200.0">
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
                <ImageView fx:id="card1" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
                <ImageView fx:id="card2" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
                <ImageView fx:id="card3" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            </AnchorPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
                <ImageView fx:id="card4" fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />
            </AnchorPane>
        </HBox>
        <Button alignment="CENTER" blendMode="SRC_ATOP" contentDisplay="CENTER" depthTest="ENABLE" mnemonicParsing="false" prefHeight="27.0" prefWidth="936.0" text="Button" textAlignment="CENTER" textOverrun="CLIP">
         <font>
            <Font name="font/Academy Engraved LET Fonts.ttf" size="12.0" />
         </font></Button>
    </VBox>
   <cursor>
      <Cursor fx:constant="DEFAULT" />
   </cursor>
</AnchorPane>
