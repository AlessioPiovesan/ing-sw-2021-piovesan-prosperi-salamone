<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainPane" xmlns="http://javafx.com/javafx/16"
            fx:controller="it.polimi.ingsw.clients.viewer.controllers.InitialLeader" stylesheets="@../css/InitialLeaderCards.css">
    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <Label alignment="CENTER" contentDisplay="CENTER" prefWidth="540.0" text="Pick two of these leader cards"
               textAlignment="CENTER">
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </Label>
        <HBox spacing="10.0">
            <AnchorPane>
                <HBox.margin>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </HBox.margin>
                <padding>
                    <Insets bottom="10.0" left="5.0" right="5.0" top="10.0"/>
                </padding>
                <ImageView fx:id="card1" fitHeight="150.0" fitWidth="200.0" onMouseClicked="#addCard"
                           pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" styleClass="firstLeader">
                    <Image url="@../graphics/cards/front/lead/CARDLEAD01.png"/>
                </ImageView>
            </AnchorPane>
            <AnchorPane>
                <HBox.margin>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </HBox.margin>
                <padding>
                    <Insets bottom="10.0" left="5.0" right="5.0" top="10.0"/>
                </padding>
                <ImageView fx:id="card2" fitHeight="150.0" fitWidth="200.0" onMouseClicked="#addCard"
                           pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <Image url="@../graphics/cards/front/lead/CARDLEAD02.png"/>
                </ImageView>
            </AnchorPane>
            <AnchorPane>
                <HBox.margin>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </HBox.margin>
                <padding>
                    <Insets bottom="10.0" left="5.0" right="5.0" top="10.0"/>
                </padding>
                <ImageView fx:id="card3" fitHeight="150.0" fitWidth="200.0" onMouseClicked="#addCard"
                           pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <Image url="@../graphics/cards/front/lead/CARDLEAD03.png"/>
                </ImageView>
            </AnchorPane>
            <AnchorPane>
                <HBox.margin>
                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
                </HBox.margin>
                <padding>
                    <Insets bottom="10.0" left="5.0" right="5.0" top="10.0"/>
                </padding>
                <ImageView fx:id="card4" fitHeight="150.0" fitWidth="200.0" onMouseClicked="#addCard"
                           pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0"
                           AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <Image url="@../graphics/cards/front/lead/CARDLEAD04.png"/>
                </ImageView>
            </AnchorPane>
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </HBox>
        <Button alignment="CENTER" blendMode="SRC_ATOP" contentDisplay="CENTER" depthTest="ENABLE" layoutX="132.4"
                mnemonicParsing="false" onMouseClicked="#confirmCards" prefWidth="540.0" text="Confirmed"
                textAlignment="CENTER" textOverrun="CLIP">
            <font>
                <Font name="font/Academy Engraved LET Fonts.ttf" size="12.0"/>
            </font>
            <VBox.margin>
                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
            </VBox.margin>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </Button>
    </VBox>
    <cursor>
        <Cursor fx:constant="DEFAULT"/>
    </cursor>
    <padding>
        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0"/>
    </padding>
</AnchorPane>
