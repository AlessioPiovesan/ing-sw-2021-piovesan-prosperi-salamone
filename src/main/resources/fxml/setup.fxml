<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" fx:id="mainPane" maxHeight="310.0" maxWidth="520.0" minHeight="310.0"
            minWidth="520.0"
            prefHeight="310.0" prefWidth="520.0" styleClass="AnchorPane"
            stylesheets="@../css/setup.css" xmlns="http://javafx.com/javafx/16"
            fx:controller="it.polimi.ingsw.clients.viewer.controllers.SetupController">
    <Button layoutX="80.0" layoutY="230.0" mnemonicParsing="false" onMouseClicked="#play" prefHeight="58.0"
            prefWidth="110.0" stylesheets="@../css/setup.css" text="PLAY" textFill="WHITE">
        <font>
            <Font size="24.0"/>
        </font>
    </Button>
    <Label layoutX="45.0" layoutY="14.0" text="Insert Nickname, Server IP and Port then click PLAY!"
           textAlignment="CENTER" textFill="WHITE">
        <font>
            <Font name="Academy Engraved LET Plain:1.0" size="18.0"/>
        </font>
    </Label>
    <Label layoutX="75.0" layoutY="70.0" text="Nickname" textFill="WHITE">
        <font>
            <Font name="Academy Engraved LET Plain:1.0" size="18.0"/>
        </font>
    </Label>
    <Label layoutX="75.0" layoutY="100.0" text="Server IP" textFill="WHITE">
        <font>
            <Font name="Academy Engraved LET Plain:1.0" size="18.0"/>
        </font>
    </Label>
    <Label layoutX="75.0" layoutY="140.0" text="Server Port" textFill="WHITE">
        <font>
            <Font name="Academy Engraved LET Plain:1.0" size="18.0"/>
        </font>
    </Label>
    <Label layoutX="75.0" layoutY="170.0" text="ID Game" textFill="WHITE">
        <font>
            <Font name="Academy Engraved LET Plain:1.0" size="18.0"/>
        </font>
    </Label>
    <Label layoutX="61.0" layoutY="196.0" text="Number of players" textFill="WHITE">
        <font>
            <Font name="Academy Engraved LET Plain:1.0" size="18.0"/>
        </font>
    </Label>
    <TextField fx:id="nicknameField" layoutX="260.0" layoutY="70.0"/>
    <TextField fx:id="serverField" layoutX="260.0" layoutY="100.0"/>
    <TextField fx:id="portField" layoutX="260.0" layoutY="140.0"/>
    <TextField fx:id="idField" layoutX="260.0" layoutY="170.0"/>
    <TextField fx:id="nPlayersField" layoutX="260.0" layoutY="210.0"/>
</AnchorPane>
